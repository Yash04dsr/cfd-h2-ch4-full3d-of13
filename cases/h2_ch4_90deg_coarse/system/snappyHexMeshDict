FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    wall
    {
        type triSurface;
        file "wall.stl";
    }
    main_inlet
    {
        type triSurface;
        file "main_inlet.stl";
    }
    outlet
    {
        type triSurface;
        file "outlet.stl";
    }
    branch_inlet
    {
        type triSurface;
        file "branch_inlet.stl";
    }
    junctionRefine
    {
        type    sphere;
        centre  (0 0 2.300000);
        radius  0.690000;
    }
    jetRefine
    {
        type    cylinder;
        point1  (0 0 2.530000);
        point2  (0 0 6.670000);
        radius  0.230000;
    }
}

castellatedMeshControls
{
    maxLocalCells       500000;
    maxGlobalCells      12000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features
    (
        { file "wall.eMesh";         level 1; }
        { file "main_inlet.eMesh";   level 1; }
        { file "outlet.eMesh";       level 1; }
        { file "branch_inlet.eMesh"; level 1; }
    );

    refinementSurfaces
    {
        wall         { level (1 1); patchInfo { type wall; } }
        main_inlet   { level (1 1); patchInfo { type patch; } }
        outlet       { level (1 1); patchInfo { type patch; } }
        branch_inlet { level (1 1); patchInfo { type patch; } }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        junctionRefine
        {
            mode    inside;
            levels  ((1e15 2));
        }
        jetRefine
        {
            mode    inside;
            levels  ((1e15 1));
        }
    }

    // Single seed point proves main + branch form ONE connected watertight fluid region
    locationInMesh (0.0 0.0 1.150000);
    allowFreeStandingZoneFaces false;
}

snapControls
{
    nSmoothPatch            3;
    tolerance               2.0;
    nSolveIter              60;
    nRelaxIter              5;
    nFeatureSnapIter        10;
    implicitFeatureSnap     false;
    explicitFeatureSnap     true;
    multiRegionFeatureSnap  false;
}

addLayersControls
{
    relativeSizes       true;
    layers
    {
        wall
        {
            nSurfaceLayers 3;
        }
    }
    expansionRatio              1.2;
    finalLayerThickness         0.5;
    minThickness                0.15;
    nGrow                       0;
    featureAngle                60;
    slipFeatureAngle            30;
    nRelaxIter                  5;
    nSmoothSurfaceNormals       1;
    nSmoothNormals              3;
    nSmoothThickness            10;
    maxFaceThicknessRatio       0.5;
    maxThicknessToMedialRatio   0.3;
    minMedialAxisAngle          90;
    nBufferCellsNoExtrude       0;
    nLayerIter                  50;
}

meshQualityControls
{
    maxNonOrtho         60;
    maxBoundarySkewness 4;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.05;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;
}

writeFlags ( scalarLevels );
mergeTolerance 1e-6;
